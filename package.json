{
  "name": "iam",
  "version": "0.6.71",
  "description": "Small IAM authentication, authorization, and session library for JavaScript.",
  "type": "module",
  "main": "./dist/express.js",
  "types": "./dist/express.d.ts",
  "files": [
    "dist",
    "*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "import": "./dist/docs.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "prepack": "npm run build",
    "example:sqlite": "node examples/sqlite.js",
    "example:express": "node examples/express.js",
    "example:auditable": "node examples/auditable.js",
    "test": "node --test",
    "lint": "eslint src examples"
  },
  "keywords": [
    "iam",
    "rbac",
    "auth",
    "authorization",
    "sessions"
  ],
  "license": "MIT",
  "dependencies": {
    "jose": "^6.2.3"
  },
  "peerDependencies": {
    "seq": "github:acmepy/seq"
  },
  "devDependencies": {
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.7.0",
    "express": "^5.0.0",
    "rollup": "^4.62.4",
    "seq": "github:acmepy/seq"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
